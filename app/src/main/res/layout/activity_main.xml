<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶栏：标题 + 历史入口（进入沉浸式页面时整条隐藏） -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/btnSkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="皮肤"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:padding="8dp"
            android:background="@drawable/input_bg"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:padding="8dp"
            android:background="@drawable/input_bg"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:padding="8dp"
            android:background="@drawable/input_bg" />
    </LinearLayout>

    <!-- 标签切换：查词 | 翻译 | 拍照（胶囊样式，选中态由代码切换背景；听力不设标签，靠右滑进入） -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tabDict"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/tab_dict"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/tab_pill" />

        <TextView
            android:id="@+id/tabTranslate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/tab_translate"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/tabCamera"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/tab_camera"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/contentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 三页横向滑动容器：查词 | 翻译 | 拍照 -->
        <com.jianyi.dict.SwipeHost
            android:id="@+id/swipeHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- ===== 听力页（第 0 格：首页向右滑进入，全屏沉浸式，不设标签入口） ===== -->
        <LinearLayout
            android:id="@+id/pageListen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="26dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/listenBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:id="@+id/listenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/listenScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/listenBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
        </LinearLayout>

        <!-- ===== 查词页 ===== -->
        <LinearLayout
            android:id="@+id/pageDict"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 词典准备中提示：一行灰色小字，不占列表区。
                 解压快的话 3 秒内就消失了，用户基本注意不到；
                 慢设备上还能看出 App 在忙，不至于以为卡死。默认 GONE。 -->
            <TextView
                android:id="@+id/dictStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/input_bg">

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:background="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/searchClear"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="×"
                    android:textSize="20sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:foreground="?android:attr/selectableItemBackground" />
            </LinearLayout>

            <!-- 纵向手势提示条：常驻占位（避免显示时列表抖动），内容按需改文字 -->
            <TextView
                android:id="@+id/pullHint"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <com.jianyi.dict.PullListView
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/list_enter" />
        </LinearLayout>

        <!-- ===== 翻译页（阶段 B 启用引擎） ===== -->
        <LinearLayout
            android:id="@+id/pageTranslate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/cloudToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="云端增强：未开启"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/input_bg" />

            <EditText
                android:id="@+id/translateInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:hint="@string/translate_hint"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/card_bg"
                android:padding="18dp" />

            <TextView
                android:id="@+id/btnTranslate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="翻译"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_card" />

            <TextView
                android:id="@+id/translateOutput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp" />
        </LinearLayout>

        <!-- ===== 拍照翻译页 ===== -->
        <LinearLayout
            android:id="@+id/pageCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="拍照"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/btn_soft" />

                <TextView
                    android:id="@+id/btnPickImage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="从相册选择"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/btn_soft" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:paddingStart="4dp"
                android:text="识别出的文字（可修改）："
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/ocrText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:hint="识别结果会显示在这里"
                android:inputType="textMultiLine"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/card_bg"
                android:padding="18dp" />

            <TextView
                android:id="@+id/btnOcrTranslate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="翻译这段文字"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_card" />
        </LinearLayout>
        </com.jianyi.dict.SwipeHost>

        <!-- ===== 历史页（覆盖层：自带背景挡住底层页面，clickable 挡住滑动事件） ===== -->
        <LinearLayout
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp">

                <TextView
                    android:id="@+id/historyBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_history"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />
            </LinearLayout>

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingTop="60dp"
                android:text="还没有查过词"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layoutAnimation="@anim/list_enter" />
        </LinearLayout>

        <!-- ===== 单词记背页：下拉进入、上滑返回；一组十题 ===== -->
        <LinearLayout
            android:id="@+id/pageStudy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/studyBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:id="@+id/studyProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.jianyi.dict.EdgeScrollView
                android:id="@+id/studyScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/studyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp" />
            </com.jianyi.dict.EdgeScrollView>

            <!-- 上滑退出把手：独立一条，浮在题目下面，不与滚动打架 -->
            <com.jianyi.dict.DragHint
                android:id="@+id/studyHint"
                android:layout_width="152dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageReading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/readingBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/back"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:background="@drawable/input_bg" />

                    <TextView
                        android:id="@+id/readingTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 下滑退出把手：只占标题栏中间一条，不压住正文 -->
                <com.jianyi.dict.DragHint
                    android:id="@+id/readingHint"
                    android:layout_width="152dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal" />
            </FrameLayout>

            <com.jianyi.dict.EdgeScrollView
                android:id="@+id/readingScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/readingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp" />
            </com.jianyi.dict.EdgeScrollView>
        </LinearLayout>
        <!-- ===== 拍照框选（覆盖层） ===== -->
        <LinearLayout
            android:id="@+id/pageCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/cropBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:gravity="end"
                    android:text="拖动选框，框住要识别的文字"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.jianyi.dict.CropView
                android:id="@+id/cropView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/btnCropAll"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="识别整张"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@drawable/btn_soft" />

                <TextView
                    android:id="@+id/btnCropOk"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="识别选中区域"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_card" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 单词本：查词页右下角圆形按钮进入，收藏的词；下滑返回 ===== -->
        <LinearLayout
            android:id="@+id/pageWordBook"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/wbBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="单词本"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wbCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.jianyi.dict.EdgeScrollView
                android:id="@+id/wbScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/wbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp" />
            </com.jianyi.dict.EdgeScrollView>

            <!-- 下滑退出把手：独立一条，浮在内容下面，不与滚动打架 -->
            <com.jianyi.dict.DragHint
                android:id="@+id/wbHint"
                android:layout_width="152dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- ===== 错题集：记背页右下角圆形按钮进入，答错过的词；下滑返回 ===== -->
        <LinearLayout
            android:id="@+id/pageWrongBook"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/wrongBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="错题集"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wrongCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.jianyi.dict.EdgeScrollView
                android:id="@+id/wrongScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/wrongBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp" />
            </com.jianyi.dict.EdgeScrollView>

            <com.jianyi.dict.DragHint
                android:id="@+id/wrongHint"
                android:layout_width="152dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- ===== 无尽配对小游戏：独立全屏页，方块自己画 ===== -->
        <LinearLayout
            android:id="@+id/pageGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/gameBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/input_bg" />

                <TextView
                    android:id="@+id/gameScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gameTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="10dp"
                android:text="点英文，再点它对应的中文；整屏消干净自动换一批新词"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.jianyi.dict.MatchGameView
                android:id="@+id/gameView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ===== 左下角白底圆形浮动按钮：单词配对小游戏（仅查词页显示）===== -->
        <ImageView
            android:id="@+id/fabGame"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|bottom"
            android:layout_margin="16dp"
            android:src="@drawable/ic_game"
            android:padding="15dp"
            android:background="@drawable/fab_circle"
            android:elevation="6dp"
            android:contentDescription="单词配对"
            android:visibility="gone" />

        <!-- ===== 右下角白底圆形浮动按钮：单词本（仅查词页显示）===== -->
        <ImageView
            android:id="@+id/fabWordBook"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:src="@drawable/ic_fav"
            android:padding="15dp"
            android:background="@drawable/fab_circle"
            android:elevation="6dp"
            android:contentDescription="单词本"
            android:visibility="gone" />

        <!-- ===== 右下角白底圆形浮动按钮：错题集（仅记背页显示）===== -->
        <ImageView
            android:id="@+id/fabWrongBook"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:src="@drawable/ic_book"
            android:padding="15dp"
            android:background="@drawable/fab_circle"
            android:elevation="6dp"
            android:contentDescription="错题集"
            android:visibility="gone" />

        <!-- ===== 左下角白底圆形浮动按钮：背词进度与计划（仅记背页显示）===== -->
        <ImageView
            android:id="@+id/fabStudyStats"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|bottom"
            android:layout_margin="16dp"
            android:src="@drawable/ic_chart"
            android:padding="15dp"
            android:background="@drawable/fab_circle"
            android:elevation="6dp"
            android:contentDescription="背词进度"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
